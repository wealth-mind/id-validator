# Environment Variables — copy this to .env and fill in your values

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/student_id_validator

# ─── JWT Secrets ──────────────────────────────────────────────────────────────
# Use long, random, unique strings for each. Never reuse between environments.
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret

# JWT expiry durations (ms/zeit format accepted by jsonwebtoken)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── QR Token ─────────────────────────────────────────────────────────────────
# HMAC-SHA256 secret used to sign QR token payloads — keep this secret!
QR_TOKEN_SECRET=replace_with_a_long_random_qr_token_secret

# QR token validity period in days
QR_TOKEN_VALID_DAYS=365

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed client origins (no trailing slash, no spaces)
# scanner client | admin dashboard
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Seed (initial admin account) ────────────────────────────────────────────
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@university.edu
SEED_ADMIN_PASSWORD=Admin@1234
